# Copy this file to ".env" and fill in your own values. NEVER commit ".env".

NODE_ENV=development
PORT=3000

# MongoDB Atlas connection string. There is NO localhost fallback: this must be set.
# Atlas > Database > Connect > Drivers. Rules:
#   - replace <username> / <password> with your Atlas *database user* (REMOVE the < > brackets)
#   - URL-encode special characters in the password (@ becomes %40, # becomes %23, etc.)
#   - keep "/inventory_management" before the "?" so the correct database is used
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>.mongodb.net/inventory_management?retryWrites=true&w=majority

# Only used when the URI above has no database name.
MONGODB_DB=inventory_management

# A long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-me-with-a-long-random-string

# true = anyone can register a Staff account from the login page. false = only admins create users.
ALLOW_REGISTRATION=false

# Set to true only when the site is served over HTTPS (production).
COOKIE_SECURE=false

# First-run administrator. "npm run dev" creates this account automatically if it does not exist yet
# (an existing account is never changed). Wrap the password in SINGLE QUOTES: '#' and '$' are special in .env files.
# After the first start you may delete the ADMIN_PASSWORD line.
ADMIN_USERNAME=admin
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
