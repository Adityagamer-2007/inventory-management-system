<div class="page-head"><h1><%= isEdit ? 'Edit user' : 'Add staff account' %></h1></div>
<%- include('../partials/errors') %>
<% var isSelf = isEdit && String(form._id) === String(currentUser._id); %>
<form action="<%= isEdit ? '/users/' + form._id + '/edit' : '/users' %>" method="post" class="panel form-panel narrow" novalidate>
  <%- include('../partials/csrf') %>
  <div class="mb-3"><label for="name" class="form-label">Full name</label>
    <input class="form-control" id="name" name="name" value="<%= form.name || '' %>" required autofocus></div>
  <div class="mb-3"><label for="username" class="form-label">Username</label>
    <input class="form-control" id="username" name="username" value="<%= form.username || '' %>" required></div>
  <div class="mb-3"><label for="email" class="form-label">Email</label>
    <input type="email" class="form-control" id="email" name="email" value="<%= form.email || '' %>" required></div>

  <% if (isEdit) { %>
    <div class="mb-3"><label for="role" class="form-label">Role</label>
      <select class="form-select" id="role" name="role" <%= isSelf ? 'disabled' : '' %>>
        <option value="staff" <%= form.role === 'staff' ? 'selected' : '' %>>Staff</option>
        <option value="admin" <%= form.role === 'admin' ? 'selected' : '' %>>Admin</option>
      </select>
      <% if (isSelf) { %><input type="hidden" name="role" value="<%= form.role %>"><div class="form-text">You cannot change your own role.</div><% } %></div>
    <% if (!isSelf) { %>
      <div class="form-check mb-3"><input class="form-check-input" type="checkbox" id="active" name="active" <%= form.active ? 'checked' : '' %>><label class="form-check-label" for="active">Account is active</label></div>
    <% } %>
  <% } else { %>
    <div class="mb-3"><label for="password" class="form-label">Initial password</label>
      <input type="password" class="form-control" id="password" name="password" autocomplete="new-password" required>
      <div class="form-text">At least 8 characters, with a letter and a number. New accounts always start as Staff.</div></div>
    <div class="mb-3"><label for="confirmPassword" class="form-label">Repeat password</label>
      <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" autocomplete="new-password" required></div>
  <% } %>
  <div class="form-actions">
    <button class="btn btn-primary" type="submit"><%= isEdit ? 'Save changes' : 'Create account' %></button>
    <a href="/users" class="btn btn-outline-secondary">Cancel</a>
  </div>
</form>
